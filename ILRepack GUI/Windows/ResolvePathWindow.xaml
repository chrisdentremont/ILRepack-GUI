<Window x:Class="ILRepack_GUI.Windows.ResolvePathWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ILRepack_GUI.Windows"
        mc:Ignorable="d" WindowStartupLocation="CenterScreen" Icon="/ILRepack GUI;component/Resources/folder_32x32.bmp"
        Title="Add Resolve Paths" Height="300" Width="500" ResizeMode="NoResize">
    <Window.Resources>
        <Style x:Key="RoundButton" TargetType="{x:Type Button}">
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Padding" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Grid x:Name="grid">
                            <Border x:Name="border" CornerRadius="8" BorderBrush="Transparent" BorderThickness="1" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          TextElement.FontWeight="Bold">
                                </ContentPresenter>
                            </Border>

                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add or remove paths to resolve missing assemblies:" VerticalAlignment="Center" Margin="16" />

        <ListView Grid.Row="1" Name="Path_ListView" Margin="8">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="15" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0" Style="{DynamicResource RoundButton}" Height="15" Width="15" Click="Remove_Path_Click">
                            <TextBlock Text="⛔" Foreground="Black" FontSize="10" FontWeight="Bold" />
                        </Button>

                        <ListViewItem Grid.Column="1" Content="{Binding Path=Path}" Foreground="{Binding Path=CanFindPath}" Focusable="False">
                            <ListViewItem.ToolTip>
                                <TextBlock Text="{Binding Path=ToolTip}" />
                            </ListViewItem.ToolTip>
                        </ListViewItem>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>

        </ListView>

        <TextBox Grid.Row="1" Name="Path_TextBox" Height="25" Margin="8" VerticalAlignment="Bottom" Text="Add a path..." VerticalContentAlignment="Center"
                 GotFocus="Path_TextBox_GotFocus" LostFocus="Path_TextBox_LostFocus" KeyDown="Path_TextBox_KeyDown"/>

        <Button Grid.Row="1" Height="25" Width="25" Content="➕" Foreground="Green" VerticalAlignment="Bottom" HorizontalAlignment="Right" 
                Margin="8" Click="Add_Path_Button_Click" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="4" HorizontalAlignment="Right">
            <Button Name="Close_Button" Height="25" Width="75" Margin="4" Content="Close" Click="Close_Button_Click" />
        </StackPanel>
    </Grid>
</Window>
