<Window x:Class="ILRepack_GUI.MergeSettings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ILRepack_GUI"
        mc:Ignorable="d" Icon="/ILRepack GUI;component/Resources/folder_32x32.bmp" ResizeMode="NoResize"
        Title="Merge Properties" Height="300" Width="300" WindowStartupLocation="CenterScreen">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="50" />
        </Grid.RowDefinitions>


        <GroupBox Grid.Row="0" Header="Select merge properties" Margin="4">
            <StackPanel Orientation="Vertical" HorizontalAlignment="Left" Margin="4">
                <StackPanel Orientation="Horizontal" Margin="4, 4, 12, 4">
                    <TextBlock Text="Target kind:" VerticalAlignment="Center" Margin="4" />
                    <ComboBox Name="Target_Kind_Combobox" VerticalContentAlignment="Center" Height="25" Width="75" Margin="4">
                        <ComboBoxItem Content="library" />
                        <ComboBoxItem Content="exe" />
                    </ComboBox>
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="4">
            <Button Name="OK_Button" Click="OK_Button_Click" Content="OK" Height="25" Width="75" Margin="4" />
            <Button Name="Cancel_Button" Click="Cancel_Button_Click" Content="Cancel" Height="25" Width="75" Margin="4" />
        </StackPanel>
    </Grid>
</Window>
